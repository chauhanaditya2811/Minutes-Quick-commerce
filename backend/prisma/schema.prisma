generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  firebaseUid  String  @unique
  email        String  @unique
  name         String?
  profileImage String?
  phone        String?
  hostelId     String?
  hostel       Hostel? @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  floor        Int?
  room         String?

  orders       Order[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Hostel {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hostels")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  imageUrl    String
  description String?
  price       Int
  unit        String
  stock       Int     @default(0)
  isDeleted   Boolean @default(false)

  orderItems   OrderItem[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@map("products")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotal    Int
  deliveryFee Int
  total       Int

  paymentStatus PaymentStatus
  orderStatus   OrderStatus
  isFiveMinute  Boolean       @default(false)

  // Delivery/customer snapshot
  customerName   String
  customerEmail  String
  customerImage  String?
  customerPhone  String
  customerHostel String
  customerFloor  Int
  customerRoom   String

  items           OrderItem[]
  payment         Payment?
  paymentAttempts PaymentAttempt[]
  reservations    InventoryReservation[]

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([userId])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Historical product snapshot
  productName String
  price       Int
  unit        String
  quantity    Int
  subtotal    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  cashfreeOrderId   String?         @unique
  cashfreePaymentId String?         @unique

  status PaymentStatus
  amount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model PaymentAttempt {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String?
  razorpayPaymentId String?         @unique
  cashfreeOrderId   String?
  cashfreePaymentId String?         @unique

  amount Int
  status PaymentStatus

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([cashfreeOrderId])
  @@map("payment_attempts")
}

model InventoryReservation {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([userId])
  @@index([status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

model Setting {
  id String @id @default(cuid())

  storeOpen    Boolean @default(true)
  deliveryFee  Int     @default(0)
  minimumOrder Int     @default(0)
  supportEmail String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

model CashfreeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@map("cashfree_webhook_events")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  DELIVERED
  CANCELLED
}
