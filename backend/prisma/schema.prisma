generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  firebaseUid  String  @unique
  email        String  @unique
  name         String?
  profileImage String?
  phone        String?
  hostelId     String?
  hostel       Hostel? @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  floor        String? // block and floor, e.g. "A/2"
  room         String?

  orders       Order[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Hostel {
  id           String                 @id @default(cuid())
  name         String                 @unique
  isActive     Boolean                @default(true)
  users        User[]
  orders       Order[]
  reservations InventoryReservation[]
  feedback     Feedback[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  // Hostels in the same stock group sell from one shared stock (e.g. every boys' hostel).
  stockGroupId String
  stockGroup   StockGroup @relation(fields: [stockGroupId], references: [id], onDelete: Restrict)

  @@index([stockGroupId])
  @@map("hostels")
}

// A shared stock: one shelf that serves one or more hostels. Stock is counted per group.
model StockGroup {
  id              String                 @id @default(cuid())
  name            String
  hostels         Hostel[]
  inventories     ProductInventory[]
  reservations    InventoryReservation[]
  // Customers shop per pool, so product requests are per pool too (one shelf, one board).
  productRequests ProductRequest[]
  // Last midnight (India time) at which this pool's request board was reset to its top 3.
  requestsResetAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("stock_groups")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  imageUrl    String
  description String?
  price       Int
  unit        String
  /// Legacy global stock from before hostel-wise inventory. Kept for reference only;
  /// customer stock now lives in ProductInventory.
  stock       Int     @default(0)
  isDeleted   Boolean @default(false)

  orderItems   OrderItem[]
  reservations InventoryReservation[]
  inventories  ProductInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@map("products")
}

// Stock of one product at one hostel. A missing row means unavailable there.
model ProductInventory {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  stockGroupId String
  stockGroup   StockGroup @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)

  // Guarded by a CHECK ("quantity" >= 0) constraint in the migration.
  quantity    Int     @default(0)
  isAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, stockGroupId])
  @@index([stockGroupId, isAvailable])
  @@map("product_inventories")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Null for guest orders, which are owned by guestAccessTokenHash instead.
  // A CHECK constraint (migration 20261030000000) requires one of the two.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // SHA-256 of the guest's secret checkout token. The token itself is never stored;
  // it doubles as the idempotency key for repeated guest checkout submissions.
  guestAccessTokenHash String? @unique

  // Store hostel whose inventory the order was placed against. Null for orders
  // created before hostel-wise inventory; customerHostel keeps the name snapshot.
  hostelId String?
  hostel   Hostel? @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  subtotal    Int
  deliveryFee Int
  total       Int

  paymentStatus      PaymentStatus
  orderStatus        OrderStatus
  isFiveMinute       Boolean       @default(false)
  // Set when a late payment found less hostel stock than was ordered; needs manual follow-up.
  inventoryShortfall Boolean       @default(false)

  // Delivery/customer snapshot
  customerName   String
  customerEmail  String? // null for guest orders
  customerImage  String?
  customerPhone  String
  customerHostel String
  customerFloor  String
  customerRoom   String

  items           OrderItem[]
  payment         Payment?
  paymentAttempts PaymentAttempt[]
  reservations    InventoryReservation[]

  createdAt   DateTime  @default(now())
  // When payment was verified and the order confirmed; starts the 10-minute delivery countdown.
  // Null for orders confirmed before this column existed and for unconfirmed orders.
  confirmedAt DateTime?
  deliveredAt DateTime?

  @@index([userId])
  @@index([hostelId])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Historical product snapshot
  productName String
  price       Int
  unit        String
  quantity    Int
  subtotal    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  cashfreeOrderId   String?         @unique
  cashfreePaymentId String?         @unique

  status PaymentStatus
  amount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model PaymentAttempt {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  provider          PaymentProvider @default(RAZORPAY)
  razorpayOrderId   String?
  razorpayPaymentId String?         @unique
  cashfreeOrderId   String?
  cashfreePaymentId String?         @unique

  amount Int
  status PaymentStatus

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([cashfreeOrderId])
  @@map("payment_attempts")
}

model InventoryReservation {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Null for holds on guest orders.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Hostel the order delivers to.
  hostelId String?
  hostel   Hostel? @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  // Stock group whose product_inventories row the units were taken from (and go back to).
  stockGroupId String?
  stockGroup   StockGroup? @relation(fields: [stockGroupId], references: [id], onDelete: SetNull)

  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([userId])
  @@index([status, expiresAt])
  @@index([orderId])
  @@index([orderId, status])
  @@index([hostelId])
  @@index([stockGroupId])
  @@map("inventory_reservations")
}

model Setting {
  id String @id @default(cuid())

  storeOpen    Boolean @default(true)
  deliveryFee  Int     @default(0)
  minimumOrder Int     @default(0)
  supportEmail String?
  // Store phone in E.164 form (e.g. +919876543210), used for the customer "Call Store" button.
  storePhone   String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

model CashfreeWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  createdAt DateTime @default(now())

  @@map("cashfree_webhook_events")
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  DELIVERED
  CANCELLED
}

// ---------- Customer feedback ----------

enum ProductRequestStatus {
  OPEN // listed for customers to upvote
  ADDED // stocked; shown as "Now available" for a few days
  HIDDEN // removed by an admin
  ARCHIVED // cleared by the nightly reset (outside the top 3); admins still see it
}

enum FeedbackStatus {
  NEW
  DONE
}

// A product customers want stocked in one pool. Other customers upvote it instead of
// requesting it again: names are matched case- and space-insensitively per pool.
model ProductRequest {
  id             String               @id @default(cuid())
  stockGroupId   String
  stockGroup     StockGroup           @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  status         ProductRequestStatus @default(OPEN)
  voteCount      Int                  @default(0)
  addedAt        DateTime?
  archivedAt     DateTime?
  votes          ProductRequestVote[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([stockGroupId, normalizedName])
  @@index([stockGroupId, status])
  @@map("product_requests")
}

// One upvote per device: voterHash is the SHA-256 of a random token kept in that browser.
model ProductRequestVote {
  id        String         @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voterHash String
  createdAt DateTime       @default(now())

  @@unique([requestId, voterHash])
  @@map("product_request_votes")
}

// Private "how can we do better" messages, only visible to admins.
model Feedback {
  id           String         @id @default(cuid())
  hostelId     String?
  hostel       Hostel?        @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  message      String
  rating       Int?
  contactPhone String?
  status       FeedbackStatus @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("feedback")
}
